{
  "name": "north-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "resolutions": {
    "lightningcss": "1.30.1"
  },
  "scripts": {
    "dev:mobile": "yarn workspace @north/mobile start",
    "ios": "yarn workspace @north/mobile ios",
    "android": "yarn workspace @north/mobile android",
    "lint:mobile": "yarn workspace @north/mobile lint",
    "dev:web": "yarn workspace @north/web dev",
    "build:web": "yarn workspace @north/web build",
    "lint:web": "yarn workspace @north/web lint",
    "dev:api": "yarn workspace @north/api dev",
    "build:api": "yarn workspace @north/api build",
    "typecheck:api": "yarn workspace @north/api typecheck",
    "dev:shared": "yarn workspace @north/shared build",
    "build:shared": "yarn workspace @north/shared build"
  }
}
